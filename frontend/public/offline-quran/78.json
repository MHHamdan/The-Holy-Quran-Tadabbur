llah_uthmani":null,"bismillah_imlaei":null,"page_no":583,"juz_no":30,"hizb_no":59,"rub_no":233,"sajda_type":null,"quarter_start":false},{"id":5709,"aya_no":37,"text_uthmani":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","text_imlaei":"رَّبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","bismillah_uthmani":null,"bismillah_imlaei":null,"page_no":583,"juz_no":30,"hizb_no":59,"rub_no":233,"sajda_type":null,"quarter_start":false},{"id":5710,"aya_no":38,"text_uthmani":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","text_imlaei":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَـٰنُ وَقَالَ صَوَابًا","bismillah_uthmani":null,"bismillah_imlaei":null,"page_no":583,"juz_no":30,"hizb_no":59,"rub_no":233,"sajda_type":null,"quarter_start":false},{"id":5711,"aya_no":39,"text_uthmani":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","text_imlaei":"ذَٰلِكَ الْيَوْمُ الْحَقُّ ۖ فَمَن شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ مَآبًا","bismillah_uthmani":null,"bismillah_imlaei":null,"page_no":583,"juz_no":30,"hizb_no":59,"rub_no":233,"sajda_type":null,"quarter_start":false},{"id":5712,"aya_no":40,"text_uthmani":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا","text_imlaei":"إِنَّا أَنذَرْنَاكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنِي كُنتُ تُرَابًا","bismillah_uthmani":null,"bismillah_imlaei":null,"page_no":583,"juz_no":30,"hizb_no":59,"rub_no":233,"sajda_type":null,"quarter_start":false}]}
