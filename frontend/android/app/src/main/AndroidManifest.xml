<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Backups: journal entries, reflections, reading progress and the last
         location live in WebView storage (app_webview/) and are described in
         the privacy policy as kept only on the device, so they are excluded
         from Google cloud backup and device transfer
         (res/xml/data_extraction_rules.xml for Android 12+,
         res/xml/backup_rules.xml for older versions). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: tadabbur://quran/2?aya=255, tadabbur://continue -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tadabbur" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tasmee (recitation practice) records the user's voice and streams it to
         the backend for speech recognition. Requested at runtime only when the
         user starts a recording; the rest of the app works without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Daily reading reminder (local notification, opt-in from the Reading Plan
         page). Requested at runtime on Android 13+ only when the user turns it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The reminder is an inexact daily notification (reminders.ts sets
         isExactNotification: false), so the exact-alarm permission that
         @capacitor/local-notifications merges in is removed: no system
         "Alarms & reminders" screen and no Play exact-alarm declaration. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- Prayer times, Qibla and nearby mosques read the location through the
         WebView's geolocation API, which needs these declared. Asked at
         runtime only when the user uses one of those tools.
         The app only needs approximate location: every page asks with
         enableHighAccuracy: false and only a position rounded to ~1 km
         (coarsen()) leaves the device. FINE is still declared because
         Capacitor's BridgeWebChromeClient requests COARSE+FINE together and,
         below Android 12 (minSdk is 24), denies the WebView geolocation
         request outright unless both are granted. On Android 12+ the user can
         pick "Approximate" in the system dialog and the app works with it.
         Revisit if minSdk moves to 31 or the bridge stops requiring FINE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
