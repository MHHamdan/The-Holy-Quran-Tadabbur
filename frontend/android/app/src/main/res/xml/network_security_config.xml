<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, system CAs only. The API URL is compiled into
     the web bundle (VITE_API_URL) and must be https:// for release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
