# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Create the upload key once and keep it safe (losing it means asking Google
# Play support to reset the upload key):
#   keytool -genkeypair -v -keystore ~/keys/tadabbur-upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/tadabbur-upload.jks
storePassword=REPLACE_ME
keyAlias=upload
keyPassword=REPLACE_ME
