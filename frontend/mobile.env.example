# Mobile (Android/iOS) build configuration — copy to .env.mobile (git-ignored).
#
# VITE_API_URL is compiled into the public app bundle: it is an address, never
# a secret. The Hugging Face token and all other credentials stay on the
# backend server.
#
# PRODUCTION API URL NOT YET DECIDED. `npm run build:mobile` refuses to build
# while this is unset, still the placeholder, not https://, or a loopback address.
VITE_API_URL=https://REPLACE_WITH_PRODUCTION_API_HOST

# Optional: public web address put in links when a verse is shared from the app
# (the app's own origin is https://localhost / capacitor://localhost, useless to
# a recipient). Leave unset to share text only.
# VITE_PUBLIC_WEB_URL=https://REPLACE_WITH_PUBLIC_WEB_HOST

# Privacy point of contact shown on /privacy (an e-mail address). Required for
# store builds: Play's User Data policy and App Store review expect one, and the
# release workflow (PRIVACY_CONTACT repository variable) refuses a v* tag
# without it. Without it, /privacy points to the in-app feedback button only.
# VITE_PRIVACY_CONTACT=privacy@REPLACE_WITH_YOUR_DOMAIN

# Debug builds use .env.mobile-dev (git-ignored) with `npm run build:mobile:dev`,
# e.g. the Android emulator reaching a backend on the host machine:
#   VITE_API_URL=http://10.0.2.2:8000
