# Mobile (Android/iOS) build configuration — copy to .env.mobile (git-ignored).
#
# VITE_API_URL is compiled into the public app bundle: it is an address, never
# a secret. The Hugging Face token and all other credentials stay on the
# backend server.
#
# PRODUCTION API URL NOT YET DECIDED. `npm run build:mobile` refuses to build
# while this is unset, still the placeholder, not https://, or a loopback address.
VITE_API_URL=https://REPLACE_WITH_PRODUCTION_API_HOST

# Debug builds use .env.mobile-dev (git-ignored) with `npm run build:mobile:dev`,
# e.g. the Android emulator reaching a backend on the host machine:
#   VITE_API_URL=http://10.0.2.2:8000
