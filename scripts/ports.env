# =============================================================================
# scripts/ports.env — the one place Tadabbur's ports are defined.
#
# This machine hosts several unrelated platforms. Tadabbur used to sit on the
# default ports for its stack (3000, 5432, 6333, 6379, 8529) and on 8002, which
# collided or risked colliding with them:
#
#   6379  a host redis-server owned by another project already held it, so the
#         tadabbur-redis container failed to bind on every single `make start`
#   3000  the most contended dev-server port on the box (a Next.js app sits on
#         3010, and anything else defaulting to 3000 takes it first)
#   8002  wedged between two Chroma instances on 8001 and 8003
#   5432  }  free today, but these are the stack defaults, so the next
#   6333  }  postgres/qdrant/surrealdb any project starts claims them
#   8529  }
#
# Everything now lives in one contiguous 193xx/198xx block. Two properties make
# it collision-free rather than merely free today:
#
#   1. It is below 32768, the start of this kernel's ephemeral range
#      (/proc/sys/net/ipv4/ip_local_port_range), so no outbound connection can
#      ever randomly occupy one of these ports.
#   2. None of them is the default port of any common service, so nothing else
#      claims them by convention.
#
# Override any value by exporting it before `make start`.
#
# Sourced by scripts/start_all.sh, scripts/stop_all.sh and the Makefile.
# Keep the repo-root .env in step with it — `make check-ports` verifies that.
# =============================================================================

# ── User-facing ──────────────────────────────────────────────────────────────
TADABBUR_FRONTEND_PORT="${TADABBUR_FRONTEND_PORT:-19300}"
TADABBUR_BACKEND_PORT="${TADABBUR_BACKEND_PORT:-19800}"

# ── Datastores ───────────────────────────────────────────────────────────────
TADABBUR_POSTGRES_PORT="${TADABBUR_POSTGRES_PORT:-19432}"
TADABBUR_QDRANT_HTTP_PORT="${TADABBUR_QDRANT_HTTP_PORT:-19633}"
TADABBUR_QDRANT_GRPC_PORT="${TADABBUR_QDRANT_GRPC_PORT:-19634}"
TADABBUR_REDIS_PORT="${TADABBUR_REDIS_PORT:-19379}"
TADABBUR_SURREAL_PORT="${TADABBUR_SURREAL_PORT:-19529}"

# ── Shared, not owned by Tadabbur ────────────────────────────────────────────
# Ollama is a machine-wide service other platforms also use. Tadabbur connects
# to it; it never starts or stops it, so this port stays at the default.
TADABBUR_OLLAMA_PORT="${TADABBUR_OLLAMA_PORT:-11434}"
