# Database
POSTGRES_USER=tadabbur
POSTGRES_PASSWORD=tadabbur_dev
POSTGRES_DB=tadabbur
DATABASE_URL=postgresql://tadabbur:tadabbur_dev@localhost:5432/tadabbur

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic API (for RAG responses)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Environment
ENVIRONMENT=development

# Admin authentication (backend — for /api/v1/admin/* routes)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_strong_random_key_here

# Frontend
VITE_API_URL=http://localhost:8000
# Admin dashboard key — must match ADMIN_API_KEY above (dev/staging only, not production)
VITE_ADMIN_API_KEY=your_strong_random_key_here
