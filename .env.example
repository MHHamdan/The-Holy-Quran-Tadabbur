# Template only: copy to .env (git-ignored) and replace every value.
# The *_dev values below match the local development stack (scripts/ports.env);
# they are not secrets and must never be used in production.

# Database
POSTGRES_USER=tadabbur
POSTGRES_PASSWORD=tadabbur_dev
POSTGRES_DB=tadabbur
DATABASE_URL=postgresql://tadabbur:tadabbur_dev@localhost:19432/tadabbur

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=19633

# Redis
REDIS_URL=redis://localhost:19379/0

# Hugging Face Inference Providers — the ONLY AI platform (backend only).
# Server-side secret: never put it in a VITE_* variable, the mobile apps, or Git.
# Create a fine-grained token with "Make calls to Inference Providers".
HF_TOKEN=
# Chat model (provider routing via HF_LLM_PROVIDER: auto | cheapest | fastest | <provider>)
HF_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_LLM_PROVIDER=auto
# Must match the vectors stored in Qdrant (1024-d)
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_STT_MODEL=openai/whisper-large-v3-turbo
HF_ZERO_SHOT_MODEL=facebook/bart-large-mnli
# Seconds per HF request (zero-shot classification uses its own 10 s budget)
HF_TIMEOUT_SECONDS=60
# Tasmee speech-to-text: huggingface (default) | faster-whisper (opt-in, needs the stt-local extra)
STT_PROVIDER=huggingface

# Environment
ENVIRONMENT=development
# Exposes /docs and raw error messages — development only (forced off in production)
DEBUG=true

# Admin authentication (backend — for /api/v1/admin/* routes)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# KG admin endpoints (X-Admin-Token). No default: unset = endpoints answer 503.
KG_ADMIN_TOKEN=

# SurrealDB knowledge graph (development stack defaults)
SURREAL_HOST=localhost
SURREAL_PORT=19529
SURREAL_USER=root
SURREAL_PASS=root

# Frontend (public build-time values only — never put a secret in a VITE_* variable;
# the admin dashboard asks for the admin key at runtime instead).
# Web behind nginx: leave empty (same origin, /api is proxied).
# Mobile (Capacitor) builds: the public HTTPS origin of the API, e.g. https://api.example.org
# Production builds refuse a loopback URL (localhost/127.x).
# Mobile builds read frontend/.env.mobile instead (template: frontend/mobile.env.example).
VITE_API_URL=

# --- docker-compose.prod.yml (production) -------------------------------------
# Required there (the stack refuses to start without them): POSTGRES_PASSWORD,
# SURREAL_PASS, HF_TOKEN, ADMIN_TOKEN, ADMIN_API_KEY, KG_ADMIN_TOKEN, CORS_ORIGINS.
# Use long random values, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
# (SURREAL_PASS above is the dev stack's; set a strong one for production.)
ADMIN_TOKEN=
# Comma-separated web and app origins, e.g. https://tadabbur.example.org,capacitor://localhost,https://localhost
CORS_ORIGINS=
# Host port of the web container (put TLS termination in front of it)
WEB_PORT=8080
BACKEND_WORKERS=2
# Optional: enables /metrics and /health/detailed via the X-Metrics-Secret header
METRICS_SECRET=
TAG=latest
